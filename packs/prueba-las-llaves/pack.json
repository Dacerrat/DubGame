      "id": "l06"
    },
    {
      "personaje": "marta",
      "inicio": 7.96,
      "fin": 9.18,
      "texto": "¿Cómo que a lo mejor?",
      "textoOriginal": "¿Cómo que a lo mejor?",
      "confianza": 1.0,
      "id": "l07"
    },
    {
      "personaje": "jose",
      "inicio": 9.18,
      "fin": 12.482,
      "texto": "Es que esta mañana cogí unas llaves, pero creía que eran las mías.",
      "textoOriginal": "Es que esta mañana cogí unas llaves, pero creía que eran las mías.",
      "confianza": 1.0,
      "id": "l08"
    },
    {
      "personaje": "marta",
      "inicio": 12.482,
      "fin": 13.39,
      "texto": "¿Y dónde están?",
      "textoOriginal": "¿Y dónde están?",
